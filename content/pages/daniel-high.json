=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-d911df8 elementor-widget elementor-widget-image\" data-id=\"d911df8\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"598\" height=\"659\" src=\"https://scupstatefoundation.org/wp-content/uploads/2025/10/Daniel-High-School.png\" class=\"attachment-full size-full wp-image-3241\" alt=\"\" srcset=\"https://scupstatefoundation.org/wp-content/uploads/2025/10/Daniel-High-School.png 598w, https://scupstatefoundation.org/wp-content/uploads/2025/10/Daniel-High-School-272x300.png 272w\" sizes=\"(max-width: 598px) 100vw, 598px\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-9663c57 e-con-full e-flex e-con e-child\" data-id=\"9663c57\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-4260f86 elementor-widget elementor-widget-heading\" data-id=\"4260f86\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Mission Statement</h2>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-20dbd20 elementor-widget elementor-widget-text-editor\" data-id=\"20dbd20\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\tD. W. Daniel High School, a community of learners, strives to prepare students for the challenges and opportunities of an ever-changing, technological, global society in a safe, caring, and community-supported environment.\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-c269115 elementor-hidden-desktop elementor-hidden-laptop elementor-hidden-tablet_extra elementor-hidd